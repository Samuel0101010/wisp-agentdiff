{
  "hooks": {
    "WorktreeCreate": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "wisp-agentdiff hook worktree-create"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "wisp-agentdiff hook worktree-remove"
          }
        ]
      }
    ]
  }
}
