{
  "hooks": {
    "WorktreeCreate": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y wisp-agentdiff@latest hook worktree-create"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y wisp-agentdiff@latest hook worktree-remove"
          }
        ]
      }
    ]
  }
}
